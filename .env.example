# Supabase — copy this file to .env.local and fill in the real values.
# Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only (local maintenance scripts). NEVER expose in the browser
# bundle or set on a frontend host. Used by: npm run seed, npm run upload:logos
SUPABASE_SECRET_KEY=your-secret-key

# Public origin used to generate absolute sitemap.xml / robots.txt URLs at
# build time (npm run build runs the sitemap script first). Set to your real
# deployed domain, e.g. https://your-domain.com
SITE_URL=https://your-domain.com
